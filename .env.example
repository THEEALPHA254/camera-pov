# ------------------------------------------------------------------
# Capture the Moment - example environment file
# Copy to .env.local for `vercel dev`, and set the same keys in the
# Vercel dashboard for production. Never commit .env.local.
# ------------------------------------------------------------------

# --- Event ---
EVENT_NAME="Grace's Graduation"
EVENT_HEADLINE="GRACE IS GRADUATING"
EVENT_HOST="Grace"
# Optional. Formatted string shown on the landing page. Leave blank until you know it.
EVENT_DATE=""
# Short code required in the ?e= URL param to upload. Guests never type this;
# the QR embeds it. Change if you ever want to rotate access.
EVENT_CODE="GRACEGRAD"
# Public site URL, used by scripts/generate_qr.py. Update before deploy.
SITE_URL="https://capture-the-moment.vercel.app"

# --- Google Drive (server side only) ---
# Get these from Google Cloud Console + `python scripts/get_refresh_token.py`
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
# ID of the parent folder in YOUR Drive where uploads go. The app will create
# subfolders "photos/" and "thumbs/" inside it on first use (drive.file scope
# means the app can only see files it created).
# vite.config.js also reads this at build time to link "View Gallery" straight
# to the shared Drive folder. Share the folder as "Anyone with the link" -> Viewer
# so guests without a Google account can view it.
DRIVE_FOLDER_ID=""

# --- Supabase ---
SUPABASE_URL=""
# Service-role key. Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Admin ---
# Password for /admin. Pick something long and random.
ADMIN_PASSWORD=""
# Random 32+ char string used to sign the admin session cookie.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`
ADMIN_SESSION_SECRET=""

# --- Salt for hashing uploader IPs (rate-limit key). Any long random string. ---
IP_HASH_SALT=""
